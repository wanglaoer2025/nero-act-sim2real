  "experiment": {
    "title": "亚甲基蓝可逆变色实验",
    "abstract": "本流程利用碱性葡萄糖对氧化态亚甲基蓝的还原褪色，以及摇晃引入溶解氧后的氧化复蓝过程。设计流程包含三次预量取试剂转移和一次反应杯摇晃，并以反应杯 ROI 的 RGB、HSV 饱和度、Lab 和归一化blue_score 记录一次复蓝与两次褪色。报告结论仅来自本次运行事件和样本。",
    "objective": "观察并记录亚甲基蓝体系的还原褪色、摇晃复蓝及再次褪色过程。",
    "principle": "亚甲基蓝在还原与空气氧化条件间发生可逆颜色变化。",
    "expected_observation": "蓝色逐渐褪去，摇晃接触空气后复蓝，随后再次褪色。",
    "reagents": [
      {
        "role": "sodium_hydroxide",
        "name": "氢氧化钠溶液",
        "formula": "NaOH",
        "planned_aliquot_ml": 40.0,
        "concentration": "1.0 M"
      },
      {
        "role": "glucose",
        "name": "葡萄糖溶液",
        "formula": "C₆H₁₂O₆",
        "planned_aliquot_ml": 40.0,
        "concentration": "0.2 M"
      },
      {
        "role": "methylene_blue",
        "name": "亚甲基蓝溶液",
        "formula": "C₁₆H₁₈ClN₃S",
        "planned_aliquot_ml": 40.0,
        "concentration": "0.1 g/L"
      }
    ],
    "planned_volume_ratio": "1:1:1",
    "planned_total_volume_ml": 120.0,
    "volume_basis": "体积依据：试剂杯预量取标签（非传感器实测）",
    "chemical_mechanism": [
      {
        "stage": "碱性葡萄糖活化",
        "equation": "CH + OH⁻ ⇌ C⁻ + H₂O",
        "note": "CH 表示葡萄糖；C⁻ 表示其在碱性介质中的还原性形式。"
      },
      {
        "stage": "摇晃复蓝（快速）",
        "equation": "O₂ + MB(reduced) → MB(oxidized)",
        "note": "空气中的氧气氧化无色还原态亚甲基蓝，恢复蓝色氧化态。"
      },
      {
        "stage": "静置褪色（慢速）",
        "equation": "MB(oxidized) + C⁻ → MB(reduced) + X⁻",
        "note": "X⁻ 代表葡萄糖的多种氧化产物；因产物是混合物，不报告虚构的唯一总反应式。"
      }
    ],
    "procedure": [
      "实时定位并锁定四个烧杯",
      "依次加入氢氧化钠溶液、葡萄糖溶液和亚甲基蓝溶液",
      "采集最左侧反应杯的 RGB、HSV、Lab 与 blue_score",
      "首次平滑饱和度低于复蓝门限后，仅自动摇晃复蓝一次",
      "确认复蓝后继续监测；第二周期平滑饱和度低于报告门限后结束",
      "从事件和颜色样本生成 JSON/HTML 报告"
    ],
    "equipment": [
